# Copy this file to .env and fill in real values.
# Any OpenAI-compatible provider works. Example for Groq:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-key-here
LLM_MODEL=pick-a-model-from-your-provider's-models-page
# Prices for LLM_MODEL in USD per million tokens (from the provider's pricing page)
LLM_PRICE_INPUT_PER_M=0.00
LLM_PRICE_OUTPUT_PER_M=0.00
